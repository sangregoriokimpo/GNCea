<model name="pool_pole_field">
    <static>true</static>

    <!-- Pool center is at (0,0), so leave this at 0 0 unless you want to shift the whole field -->
    <pose>5.0 0 -1.5 0 0 1.57</pose>

    <!-- Estimates:
        pole diameter = 0.075 m  (radius 0.0375)
        pole length   = 0.90  m
        clearance above floor = 0.45 m  => center_z = 0.45 + 0.90/2 = 0.90
        column spacing: x = -1.5, 0, +1.5
        row spacing:    y = -2.5, 0, +2.5
    -->

    <!-- Helper: cylinder geometry repeated everywhere -->
    <!-- Row y = -2.5 -->
    <link name="rowm1_left_white">
        <pose>-1.5 -2.5 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
    </link>

    <link name="rowm1_center_red">
        <pose>0.0 -2.5 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
    </link>

    <link name="rowm1_right_white">
        <pose>1.5 -2.5 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
    </link>

    <!-- Row y = 0 -->
    <link name="row0_left_white">
        <pose>-1.5 0.0 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
    </link>

    <link name="row0_center_red">
        <pose>0.0 0.0 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
    </link>

    <link name="row0_right_white">
        <pose>1.5 0.0 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
    </link>

    <!-- Row y = +2.5 -->
    <link name="rowp1_left_white">
        <pose>-1.5 2.5 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
    </link>

    <link name="rowp1_center_red">
        <pose>0.0 2.5 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
    </link>

    <link name="rowp1_right_white">
        <pose>1.5 2.5 0.9 0 0 0</pose>
        <collision name="collision">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
    </link>

    </model>